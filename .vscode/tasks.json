{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docs-preview: serve",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\docs-preview\\start-preview.cmd",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        },
        "env": {
          "HOST": "127.0.0.1",
          "PORT": "4173"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "docs-preview",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ERP docs preview listening on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
