{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "ERP Docs Preview",
      "program": "${workspaceFolder}/tools/docs-preview/preview-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "4173"
      },
      "serverReadyAction": {
        "pattern": "ERP docs preview listening on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally",
        "killOnServerStop": true
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Docs Preview Server only",
      "program": "${workspaceFolder}/tools/docs-preview/preview-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "4173"
      }
    }
  ]
}
