{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "ERP Docs Preview",
      "program": "${workspaceFolder}/tools/docs-preview/preview-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "ERP docs preview listening on http://[^:]+:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "debugWithChrome",
        "killOnServerStop": true
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Docs Preview Server only",
      "program": "${workspaceFolder}/tools/docs-preview/preview-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
