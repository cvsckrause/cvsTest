{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "ERP Docs Preview",
      "url": "http://127.0.0.1:4173/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "docs-preview: serve"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Docs Preview Server only",
      "program": "${workspaceFolder}/tools/docs-preview/preview-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "4173"
      }
    }
  ]
}
